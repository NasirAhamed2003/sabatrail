{
  "info": {
    "name": "SabaTrail API",
    "description": "Every SabaTrail endpoint, in an order that runs end to end (Run collection). Set adminPassword before running; userEmail gets a unique value automatically. Expected status codes are checked by each request's tests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// A fresh visitor account per run",
          "if (!pm.collectionVariables.get(\"userEmail\")) {",
          "  pm.collectionVariables.set(\"userEmail\", `postman-${Date.now()}@sabatrail.local`);",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "userEmail",
      "value": ""
    },
    {
      "key": "userPassword",
      "value": "trail2026go"
    },
    {
      "key": "adminEmail",
      "value": "admin@sabatrail.local"
    },
    {
      "key": "adminPassword",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    },
