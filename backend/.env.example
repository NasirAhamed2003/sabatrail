# MySQL / MariaDB connection. URL-encode special characters in the password (e.g. @ -> %40).
DATABASE_URL="mysql://sabatrail:CHANGE_ME@localhost:3306/sabatrail"

# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="CHANGE_ME"

PORT=5000

# Browser origins allowed to call the API (comma-separated)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Mount /api/test-* diagnostic routes (development only)
ENABLE_TEST_ROUTES=false

# Admin account created by `npx prisma db seed`
SEED_ADMIN_EMAIL="admin@sabatrail.local"
SEED_ADMIN_PASSWORD="CHANGE_ME"
